# Copy to .env and fill in. Never commit .env (or tokens.json, the Yahoo OAuth tokens written by yahoo_auth.py).
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Postgres with the nba_* tables and the "odds" schema (local today: localhost:5433/nba_fantasy)
DATABASE_URL=postgresql://user:password@host:5433/nba_fantasy
