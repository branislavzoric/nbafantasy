    {
      "parameters": {
        "jsCode": "// Pick the lowest-numbered approved card and build its caption.\nconst all = $input.all();\nif (!all.length) return [];\nconst order = all\n  .map((item, i) => ({ i, name: item.binary.data.fileName }))\n  .sort((a, b) => a.name.localeCompare(b.name));\nconst idx = order[0].i;\nconst card = JSON.parse((await this.helpers.getBinaryDataBuffer(idx, 'data')).toString('utf8'));\n\nconst caption = card.caption || [\n  `🏀 ${card.headline}`,\n  ``,\n  `${card.player} (${card.team}) – 2026-27 projection:`,\n  `${card.pts} PTS · ${card.reb} REB · ${card.ast} AST · ${card.stl} STL · ${card.blk} BLK`,\n  `${card.fppg} fantasy pts/game (#${card.ranks.fppg} overall)`,\n  ``,\n  card.summary,\n  ``,\n  `#NBA #FantasyBasketball #NBAFantasy #${card.team} #FantasyNBA`\n].join('\\n');\n\nreturn [{ json: { ...card, caption: caption.slice(0, 2200) } }];"
      },
      "id": "eda2b36d-21ac-4b01-89da-f4d23d205fce",
      "name": "Build Caption",
      "type": "n8n-nodes-base.code",
