      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Read Approved JSON",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Nightly top 10: post the oldest night first, and within a night count down\n// from #10 to #1. Files are named <date>_<rank>_<player>.json.\nconst all = $input.all();\nif (!all.length) return [];\nconst order = all\n  .map((item, i) => {\n    const name = item.binary.data.fileName;\n    const [date, rank] = name.split('_');\n    return { i, date, rank: Number(rank) };\n  })\n  .sort((a, b) => a.date.localeCompare(b.date) || b.rank - a.rank);\nconst idx = order[0].i;\nconst card = JSON.parse((await this.helpers.getBinaryDataBuffer(idx, 'data')).toString('utf8'));\nreturn [{ json: { ...card, caption: card.caption.slice(0, 2200) } }];"
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Build Caption",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
