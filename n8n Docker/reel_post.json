    {
      "id": "c3000000-0000-4000-8000-000000000011",
      "name": "Move to Posted",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        2000,
        200
      ],
      "parameters": {
        "command": "=mkdir -p /files/content/reels/posted && mv /files/content/reels/approved/{{ $('Pick Reel').first().json.slug }}.* /files/content/reels/posted/"
      }
    },
    {
      "id": "c3000000-0000-4000-8000-000000000012",
      "name": "Still Processing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        420
      ],
      "parameters": {
        "jsCode": "// Instagram is still processing the video: check again, unless it failed or is taking too long.\nconst s = $input.first().json;\nif (s.status_code === 'ERROR' || s.status_code === 'EXPIRED') {\n  throw new Error(`Instagram could not process the reel: ${s.status_code} ${s.status || ''}`);\n}\nif ($runIndex >= 30) throw new Error(`Reel still not processed after ~5 minutes (${s.status_code})`);\nreturn [{ json: s }];"
      }
    }
