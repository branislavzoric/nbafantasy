{
  "id": "nbaReelPostWf001",
  "name": "NBA Fantasy - Post Reel",
  "active": false,
  "nodes": [
    {
      "id": "c3000000-0000-4000-8000-000000000001",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {}
    },
    {
      "id": "c3000000-0000-4000-8000-000000000002",
      "name": "Read Approved JSON",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "fileSelector": "/files/content/reels/approved/*.json",
        "options": {}
      }
    },
    {
      "id": "c3000000-0000-4000-8000-000000000003",
      "name": "Pick Reel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ],
      "parameters": {
        "jsCode": "// Oldest night first, then by rank. Files are named <date>_<rank>_<player>.json.\nconst all = $input.all();\nif (!all.length) return [];\nconst order = all\n  .map((item, i) => { const [date, rank] = item.binary.data.fileName.split('_'); return { i, date, rank: Number(rank) }; })\n  .sort((a, b) => a.date.localeCompare(b.date) || a.rank - b.rank);\nconst reel = JSON.parse((await this.helpers.getBinaryDataBuffer(order[0].i, 'data')).toString('utf8'));\nreturn [{ json: { ...reel, caption: reel.caption.slice(0, 2200) } }];"
      }
    },
    {
      "id": "c3000000-0000-4000-8000-000000000004",
      "name": "Read Reel Video",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        600,
        300
      ],
      "parameters": {
        "fileSelector": "=/files/content/reels/approved/{{ $json.video }}",
        "options": {}
      }
    },
    {
      "id": "c3000000-0000-4000-8000-000000000005",
      "name": "Upload Video to Cloudinary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.cloudinary.com/v1_1/biah2b8d/video/upload",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            },
            {
              "name": "upload_preset",
              "value": "nbafantasy"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "c3000000-0000-4000-8000-000000000006",
