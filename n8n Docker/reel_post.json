        "url": "https://graph.instagram.com/v23.0/17841427355256599/media",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "media_type",
              "value": "REELS"
            },
            {
              "name": "video_url",
              "value": "={{ $json.secure_url }}"
            },
            {
              "name": "caption",
              "value": "={{ $('Pick Reel').first().json.caption }}"
            },
            {
              "name": "share_to_feed",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpQueryAuth": {
          "id": "YVsx47E5FOuJ68i8",
          "name": "Instagram token"
        }
      }
    },
    {
